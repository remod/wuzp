# The API reference of the public headers, built by ci/docs.sh into docs/api/, which the site links (see mkdocs.yml).
# Settings that are not listed keep Doxygen's defaults.

PROJECT_NAME           = wuzp
PROJECT_BRIEF          = "Wrong Unit? Zero Points! Compile-time checks for units, coordinate systems and points vs. vectors."
OUTPUT_DIRECTORY       = docs
HTML_OUTPUT            = api
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = wuzp/include wuzp_eigen/include wuzp_blitz/include wuzp_boost/include wuzp_mp_units/include

# The public API: the headers of the core, the transformations and the backends, except the internal/ directories and the
# internal namespaces (see "Versioning" in CONTRIBUTING.md).
INPUT                  = wuzp/include wuzp_eigen/include wuzp_blitz/include wuzp_boost/include wuzp_mp_units/include
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */internal/*
EXCLUDE_SYMBOLS        = internal *::internal *::internal::*
# The first sentence of a comment is its brief description (JAVADOC_AUTOBRIEF and QT_AUTOBRIEF below), and Doxygen ends a
# sentence at every period followed by a space or a line break, also that of an abbreviation. In the doc comments, lines that
# start with //!, /// or /**, or with * inside a /** comment, the filter writes "e.g.", "i.e.", "eq." and "eqs." with Doxygen's
# escaped space, "e.g.\ ", which does not end it (https://www.doxygen.nl/manual/config.html#cfg_javadoc_autobrief). It keeps
# the lines, so the line numbers stay right, and the source pages show the unfiltered headers (FILTER_SOURCE_FILES is NO).
# ci/docs.sh fails if an escaped space shows in the reference, e.g. in a code span, which Doxygen prints as written.
INPUT_FILTER           = "sed -E '/^[[:space:]]*(\/\/[\/!]|\/\*\*|\*([[:space:]]|$))/s/(^|[^[:alnum:]_])([Ee]\.g|[Ii]\.e|[Ee]qs?)\.( |$)/\1\2.\\ /g'"

# Document every declaration, also those without a comment, since many aliases and traits are only explained by their names.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES
SOURCE_BROWSER         = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

# No Graphviz: the site has a class hierarchy diagram of its own.
HAVE_DOT               = NO
CLASS_GRAPH            = TEXT

# Warnings go to build/doxygen_warnings.log, which ci/docs.sh checks: warnings other than the known ones fail the build.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = build/doxygen_warnings.log
