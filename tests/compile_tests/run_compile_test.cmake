# Runs one compile test. Usage:
#   cmake -D CONFIG=<config.cmake> -D CASE=<case.cpp> -D BUILD_DIR=<dir> -P run_compile_test.cmake
#
# CONFIG is generated by tests/CMakeLists.txt and describes the toolchain and the backends to test against. The case
# is compiled as part of a small project generated from CMakeLists.txt.in. Configuring that project must always
# succeed, so that a broken setup cannot be mistaken for an expected compile error.

cmake_minimum_required(VERSION 3.22)

foreach(_variable CONFIG CASE BUILD_DIR)
    if(NOT DEFINED ${_variable})
        message(FATAL_ERROR "${_variable} is not defined.")
    endif()
endforeach()

include("${CONFIG}")
include("${CMAKE_CURRENT_LIST_DIR}/CompileTest.cmake")
wuzp_compile_test_parse("${CASE}" CASE)

if(CASE_EXPECT STREQUAL "error" AND CASE_ERRORS STREQUAL "")
    message(FATAL_ERROR "${CASE}: no expected error applies to this configuration "
        "(units=${WUZP_COMPILE_TEST_UNITS}, values=${WUZP_COMPILE_TEST_VALUES}, compiler=${WUZP_COMPILE_TEST_COMPILER}). "
        "Add a matching '// wuzp-error' or '// wuzp-static-assert' annotation.")
endif()

# Set up the project. Unchanged files are not touched, so that repeated runs reuse the configuration.
file(MAKE_DIRECTORY "${BUILD_DIR}/src")
file(COPY_FILE "${WUZP_COMPILE_TEST_CMAKELISTS}" "${BUILD_DIR}/src/CMakeLists.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${CASE}" "${BUILD_DIR}/src/test.cpp" ONLY_IF_DIFFERENT)

set(_configure_args -S "${BUILD_DIR}/src" -B "${BUILD_DIR}/build" -G "${WUZP_COMPILE_TEST_GENERATOR}"
    -D "CMAKE_CXX_COMPILER=${WUZP_COMPILE_TEST_CXX_COMPILER}")
if(NOT WUZP_COMPILE_TEST_MAKE_PROGRAM STREQUAL "")
    list(APPEND _configure_args -D "CMAKE_MAKE_PROGRAM=${WUZP_COMPILE_TEST_MAKE_PROGRAM}")
endif()
if(NOT WUZP_COMPILE_TEST_TOOLCHAIN_FILE STREQUAL "")
    list(APPEND _configure_args -D "CMAKE_TOOLCHAIN_FILE=${WUZP_COMPILE_TEST_TOOLCHAIN_FILE}")
endif()
execute_process(
    COMMAND "${CMAKE_COMMAND}" ${_configure_args}
    RESULT_VARIABLE _result
    OUTPUT_VARIABLE _output
    ERROR_VARIABLE _output
)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Configuring the compile test failed, which is never expected:\n${_output}")
endif()

execute_process(
    COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}/build"
    RESULT_VARIABLE _result
    OUTPUT_VARIABLE _output
    ERROR_VARIABLE _output
)

if(CASE_EXPECT STREQUAL "compiles")
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Expected the code to compile, but it failed:\n${_output}")
    endif()
    message(STATUS "The code compiles, as expected.")
    return()
endif()

if(_result EQUAL 0)
    message(FATAL_ERROR "Expected the code to fail to compile, but it compiled:\n${_output}")
endif()
foreach(_regex IN LISTS CASE_ERRORS)
    # The expected error must appear within a single line of a compiler error.
    if(NOT _output MATCHES "error[^\n]*${_regex}")
        message(FATAL_ERROR "The code failed to compile, but not with the expected error '${_regex}':\n${_output}")
    endif()
    message(STATUS "Found the expected error '${_regex}'.")
endforeach()
