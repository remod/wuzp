# Generated by tests/CMakeLists.txt. Compiles a single code snippet against wuzp to check whether it compiles.
cmake_minimum_required(VERSION 3.22...3.31)
project(wuzp_compile_test LANGUAGES CXX)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)

@WUZP_COMPILE_TEST_SETUP@

add_executable(compile_test test.cpp)
target_compile_features(compile_test PRIVATE cxx_std_20)
target_compile_options(compile_test PRIVATE @WUZP_WARNING_OPTIONS@)
target_compile_definitions(compile_test PRIVATE @WUZP_TEST_DEFINITIONS@)
target_include_directories(compile_test PRIVATE "@CMAKE_CURRENT_SOURCE_DIR@/src")
target_link_libraries(compile_test PRIVATE @WUZP_TEST_LINK_LIBRARIES@)
