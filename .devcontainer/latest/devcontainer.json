{
  // latest: Ubuntu 26.04, the newest supported dependencies.
  // The image is the one CI uses: ci/image.sh pulls it, or builds it if the Dockerfile changed.
  "name": "wuzp (latest, Ubuntu 26.04)",
  "initializeCommand": "ci/image.sh ensure latest --tag wuzp-dev:latest",
  "image": "wuzp-dev:latest",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=wuzp-ccache-latest,target=/ccache,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "cmake.useCMakePresets": "always",
        "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
        "C_Cpp.intelliSenseEngine": "disabled"
      }
    }
  }
}
